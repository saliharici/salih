rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // "pano" koleksiyonundaki "mainDisplay" belgesine erişim kuralları
    match /pano/mainDisplay {

      // Okuma (get) izni:
      // Herkes (hem giriş yapmış hem de yapmamış kullanıcılar) bu belgeyi okuyabilir.
      // Bu, index.html'in panodaki verileri herkese gösterebilmesi için gereklidir.
      allow get: if true;

      // Yazma (update) ve oluşturma (create) izni:
      // Sadece kimlik doğrulaması yapmış bir kullanıcı (request.auth != null)
      // bu belgeyi güncelleyebilir veya oluşturabilir.
      // Bu, sadece admin.html'den giriş yapmış yöneticilerin veri değiştirebilmesini sağlar.
      allow write: if request.auth != null;
    }
  }
}
