rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pano/{displayId} {
      // Herkesin pano verilerini okumasına izin ver
      allow read: if true;
      // Sadece kimliği doğrulanmış kullanıcıların yazmasına izin ver
      allow write: if request.auth != null;
    }
  }
}
